{
  "name": "arc-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx server/migrate.ts",
    "eval": "tsx scripts/evaluate.ts",
    "test:browser": "playwright test",
    "eval:check": "tsx scripts/evaluate.ts --dry-run",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs src server shared content",
    "check": "npm run format:check && npm run architecture:check && npm run typecheck"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.125",
    "@fastify/static": "^10.1.6",
    "@tanstack/react-query": "^5.104.1",
    "ai": "^6.0.303",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "17.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
